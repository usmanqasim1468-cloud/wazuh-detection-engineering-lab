<!--
  Custom decoder for a fictional application log format.
  Location on the Wazuh manager: /var/ossec/etc/decoders/custom_myapp_decoder.xml

  Sample line this decoder is written against:
      ALERT: User admin failed login from 192.168.1.50

  A decoder only turns unstructured text into named fields. It makes no
  judgement about whether anything is wrong — that is the job of the rule in
  custom_myapp_rules.xml.

  Pattern note: Wazuh's default expression engine does NOT support square
  bracket character classes. A pattern such as ([0-9.]+) is valid in most
  other engines but silently matches nothing here, with no error to explain
  why. (\S+) is used instead.

  After saving, set ownership so the analysis engine can read the file, then
  restart the manager:
      sudo chown wazuh:wazuh /var/ossec/etc/decoders/custom_myapp_decoder.xml
      sudo systemctl restart wazuh-manager
      sudo /var/ossec/bin/wazuh-logtest
-->

<decoder name="custom_failed_login">
  <prematch>ALERT: </prematch>
  <regex>ALERT: User (\w+) failed login from (\S+)</regex>
  <order>username,srcip</order>
</decoder>
